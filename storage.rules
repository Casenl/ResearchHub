rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Research file attachments
    match /research/{researchId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|text/.*|application/vnd.openxmlformats.*|application/json');
    }

    // Context document files
    match /context-documents/{docId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Branding assets (logo uploads) — admin write, any authenticated read
    match /branding/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg|image/svg\\+xml|image/webp');
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

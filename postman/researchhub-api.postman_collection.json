    {
      "name": "8. Lifecycle (Ordered Workflow)",
      "description": "End-to-end lifecycle test. Run this folder sequentially via Postman Collection Runner to exercise the full create -> source -> validate -> query -> archive workflow.\n\nEach request chains to the next via environment variables.",
      "item": [
        {
          "name": "1. Create Research",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lifecycle Test - Postman\",\n  \"description\": \"End-to-end lifecycle test created via Postman Collection Runner\",\n  \"output_format\": \"competitive\",\n  \"origin\": \"agent\",\n  \"agent_identity\": {\n    \"agent_id\": \"postman-lifecycle\",\n    \"agent_name\": \"Postman Lifecycle\",\n    \"agent_version\": \"1.0.0\",\n    \"run_id\": \"lifecycle-run\"\n  },\n  \"dimensions\": {\n    \"market_ids\": [\"NL\"],\n    \"domain_ids\": [\"managed_services\"],\n    \"sector_ids\": []\n  },\n  \"synthesis\": \"\",\n  \"assumptions\": [\"Lifecycle test assumption\"],\n  \"refresh_schedule\": \"ad_hoc\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research",
              "host": ["{{base_url}}"],
              "path": ["research"]
            },
            "description": "Step 1: Create a new research entry for the lifecycle test."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Status is draft\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal(\"draft\");",
                  "});",
                  "",
                  "// Chain to next request",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"research_id\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Add Source",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notebook_id\": \"nb-test-1\",\n  \"title\": \"Lifecycle Test Source\",\n  \"url\": \"https://example.com/lifecycle-test\",\n  \"publisher\": \"Test Publisher\",\n  \"publication_date\": \"2026-01-15\",\n  \"quality_tier\": 6,\n  \"discovered_by\": \"perplexity\",\n  \"notes\": \"Added during lifecycle test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/sources",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "sources"]
            },
            "description": "Step 2: Add a source to the research entry. Requires a notebook with id 'nb-test-1' to exist in the research entry (see Sources folder note about notebook seeding)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Validation status is unverified\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.validation_status).to.equal(\"unverified\");",
                  "});",
                  "",
                  "// Chain to next request",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"source_id\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Validate Source",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"validation_status\": \"corroborated\",\n  \"validation_notes\": \"Confirmed via secondary source during lifecycle test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/sources/{{source_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "sources", "{{source_id}}", "validate"]
            },
            "description": "Step 3: Validate the source as corroborated. Trust tier should drop from 6 to 4."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"New tier is adjusted\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"new_tier\");",
                  "    pm.expect(json.new_tier).to.be.below(6);",
                  "});",
                  "",
                  "pm.test(\"New status is corroborated\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.new_status).to.equal(\"corroborated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

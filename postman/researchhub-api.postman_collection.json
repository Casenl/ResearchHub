            },
            "description": "Query research with filters: region, domain, sector, origin, min_trust_tier, status, fresher_than. Paginated with limit and offset."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has total\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"total\");",
                  "});",
                  "",
                  "pm.test(\"Response has results array\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"results\");",
                  "    pm.expect(json.results).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Research",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"synthesis\": \"Updated synthesis via Postman\",\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}"]
            },
            "description": "Update research fields. Every update auto-creates an audit log entry and sets updated_at. Requires read_write or admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response confirms update\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\", \"Research updated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Archive Research (Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}"]
            },
            "description": "Soft delete (archive) a research entry. Sets status to 'archived'. Requires admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response confirms archival\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\", \"Research archived\");",
                  "});"
                ],

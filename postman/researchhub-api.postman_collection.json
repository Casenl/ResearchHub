                  "",
                  "pm.test(\"Research has title\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.title).to.include(\"Lifecycle Test\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },

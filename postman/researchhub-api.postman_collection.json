      ]
    },
    {
      "name": "4. Sources",
      "description": "Source management endpoints. Sources live inside research notebooks.\n\nNOTE: Before adding sources, the research entry must have at least one notebook in its notebooks array. The UpdateResearchSchema does not include a 'notebooks' field, so notebooks must be seeded via Firestore directly (Admin SDK, Firebase Console, or during research creation). The prerequisite request in this folder may not work if the API strips the notebooks field.",
      "item": [
        {
          "name": "[Prerequisite] Seed Notebook via PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notebooks\": [\n    {\n      \"id\": \"nb-test-1\",\n      \"type\": \"competitive\",\n      \"sources\": [],\n      \"findings\": \"\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}"]
            },
            "description": "Prerequisite: Seed a notebook into the research entry so sources can be added.\n\nIMPORTANT: The UpdateResearchSchema only allows specific fields (title, description, status, findings, synthesis, assumptions, review_status, change_log). The 'notebooks' field is NOT in the update schema and will be stripped by Zod validation. You may need to seed the notebook directly via:\n- Firebase Console\n- Firebase Admin SDK\n- The seed script\n\nThis request is included for documentation purposes. If it returns 200 but the notebooks field wasn't actually written, seed the notebook through another method."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Note: Even if this returns 200, the notebooks field may have been",
                  "// stripped by Zod validation. Verify via GET /research/{{research_id}}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Add Source",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notebook_id\": \"nb-test-1\",\n  \"title\": \"Test Source\",\n  \"url\": \"https://example.com/test\",\n  \"publisher\": \"Test Publisher\",\n  \"publication_date\": \"2026-01-15\",\n  \"quality_tier\": 6,\n  \"discovered_by\": \"perplexity\",\n  \"notes\": \"Added via Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/sources",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "sources"]
            },
            "description": "Add a source to a research notebook. The notebook_id must reference an existing notebook in the research entry. The source automatically gets validation_status 'unverified'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Validation status is unverified\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"validation_status\", \"unverified\");",
                  "});",
                  "",
                  "// Chain: store source_id for subsequent requests",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"source_id\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Validate Source",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"validation_status\": \"corroborated\",\n  \"validation_notes\": \"Confirmed via secondary source\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/sources/{{source_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "sources", "{{source_id}}", "validate"]
            },
            "description": "Record a validation event on a source. Validation status can be: unverified, corroborated, human_verified, disputed. Trust tier is automatically adjusted:\n- corroborated: tier - 2 (min 1)\n- human_verified: tier - 3 (min 1)\n- disputed: tier + 2 (max 8)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"New tier is lower than original (6)\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"new_tier\");",
                  "    pm.expect(json.new_tier).to.be.below(6);",
                  "});",
                  "",
                  "pm.test(\"New status is corroborated\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"new_status\", \"corroborated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Files",
      "description": "File upload and listing endpoints. Files are stored in Firebase Storage and linked to research entries via the file-attachments Firestore collection.",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"test-doc.txt\",\n  \"file_type\": \"text/plain\",\n  \"file_data\": \"VGhpcyBpcyBhIHRlc3QgZmlsZQ==\",\n  \"source_id\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/files",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "files"]
            },
            "description": "Upload a file attachment as base64-encoded data. Maximum 50MB. File types validated by magic bytes for PDF and DOCX; text-based types skip byte validation.\n\nAllowed MIME types: application/pdf, text/markdown, text/plain, application/vnd.openxmlformats-officedocument.wordprocessingml.document, text/csv, application/json"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has download_url\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"download_url\");",
                  "});",
                  "",
                  "pm.test(\"Response has id and file metadata\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json).to.have.property(\"file_name\", \"test-doc.txt\");",
                  "    pm.expect(json).to.have.property(\"file_type\", \"text/plain\");",
                  "    pm.expect(json).to.have.property(\"size_bytes\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}/files",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}", "files"]
            },
            "description": "List all file attachments for a research entry, ordered by uploaded_at descending."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {

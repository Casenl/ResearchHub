          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has results\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"results\");",
                  "    pm.expect(json.results).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Total is at least 1\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.total).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6. Archive Research (Cleanup)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}"]
            },
            "description": "Step 6: Archive the research entry to clean up after the lifecycle test."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",

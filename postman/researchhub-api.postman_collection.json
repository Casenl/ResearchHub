          "name": "Get Landscape",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/intelligence/landscape?region=NL",
              "host": ["{{base_url}}"],
              "path": ["intelligence", "landscape"],
              "query": [
                {
                  "key": "region",
                  "value": "NL"
                }
              ]
            },
            "description": "Get full region x domain competitive matrix. Shows research count, average trust tier, and latest update per domain."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has landscape array\", function() {",

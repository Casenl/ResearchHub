{
  "info": {
    "_postman_id": "researchhub-api-collection",
    "name": "ResearchHub API",
    "description": "ITQ Market Intelligence Portal — Agent-Driven Research Platform REST API.\n\nAll endpoints (except /health) require Bearer token authentication via API key.\n\nBase URL is a Cloud Functions v2 endpoint deployed in europe-west1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health",
      "description": "Health check endpoint. No authentication required.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Returns service health status. No authentication required."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has status ok\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"status\", \"ok\");",
                  "});",
                  "",
                  "pm.test(\"Response has timestamp\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"timestamp\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth Keys",
      "description": "API key management endpoints. All require admin permission.",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Agent Key\",\n  \"permissions\": \"read_write\",\n  \"agent_identity\": {\n    \"agent_id\": \"test-agent\",\n    \"agent_name\": \"Test Agent\",\n    \"agent_version\": \"1.0.0\",\n    \"run_id\": \"manual-test\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/keys",
              "host": ["{{base_url}}"],
              "path": ["auth", "keys"]
            },
            "description": "Create a new API key. Returns the plaintext key exactly once — store it securely. Requires admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has key_id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"key_id\");",
                  "});",
                  "",
                  "pm.test(\"Response has plaintext_key\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"plaintext_key\");",
                  "    pm.expect(json.plaintext_key).to.match(/^rh_/);",
                  "});",
                  "",
                  "pm.test(\"Response has name and permissions\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"name\");",
                  "    pm.expect(json).to.have.property(\"permissions\");",
                  "});",
                  "",
                  "// Chain: store key_id for subsequent requests",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"api_key_id\", json.key_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/keys",
              "host": ["{{base_url}}"],
              "path": ["auth", "keys"]
            },
            "description": "List all API keys with metadata. The key_hash is never included in responses. Requires admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Items do not expose key_hash\", function() {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0]).to.not.have.property(\"key_hash\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/keys/{{api_key_id}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "keys", "{{api_key_id}}"]
            },
            "description": "Revoke an API key by setting is_active to false. Revocation is immediate. Requires admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response confirms revocation\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\", \"Key revoked\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Research",
      "description": "Research CRUD endpoints. Create, read, query, update, and archive research entries.",
      "item": [
        {
          "name": "Create Research",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Research - Postman\",\n  \"description\": \"Created via Postman for testing\",\n  \"output_format\": \"report\",\n  \"origin\": \"agent\",\n  \"agent_identity\": {\n    \"agent_id\": \"postman-test\",\n    \"agent_name\": \"Postman Test\",\n    \"agent_version\": \"1.0.0\",\n    \"run_id\": \"manual\"\n  },\n  \"dimensions\": {\n    \"market_ids\": [\"NL\"],\n    \"domain_ids\": [\"managed_services\"],\n    \"sector_ids\": []\n  },\n  \"synthesis\": \"\",\n  \"assumptions\": [\"Test assumption\"],\n  \"refresh_schedule\": \"ad_hoc\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/research",
              "host": ["{{base_url}}"],
              "path": ["research"]
            },
            "description": "Create a new research entry. Auto-sets origin to 'agent', review_status to 'pending', and status to 'draft'. Requires read_write or admin permission."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Status is draft\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"status\", \"draft\");",
                  "});",
                  "",
                  "pm.test(\"Review status is pending\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"review_status\", \"pending\");",
                  "});",
                  "",
                  "// Chain: store research_id for subsequent requests",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"research_id\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Research by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/research/{{research_id}}",
              "host": ["{{base_url}}"],
              "path": ["research", "{{research_id}}"]
            },
            "description": "Fetch a single research entry by ID with full detail including notebooks, sources, and file attachment URLs."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct id\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\", pm.environment.get(\"research_id\"));",
                  "});",
                  "",
                  "pm.test(\"Response has title\", function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"title\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Query Research",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/research?origin=agent&limit=5",
              "host": ["{{base_url}}"],
              "path": ["research"],
              "query": [
                {
                  "key": "origin",
                  "value": "agent"
                },
                {
                  "key": "limit",
                  "value": "5"
                }

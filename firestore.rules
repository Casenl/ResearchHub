rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helper Functions ============

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isResearcherOrAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'researcher'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevent updates to specific privileged fields (unless admin)
    function doesNotTouch(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ============ Research ============

    match /research/{researchId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      // Authors can update their own research, but nobody can directly set status
      // (workflow transitions must go through the API/service layer)
      allow update: if isAuthenticated()
        && (resource.data.author_id == request.auth.uid || isAdmin())
        && doesNotTouch(['status']);
      allow delete: if isAdmin();

      // Notebooks sub-collection
      match /notebooks/{notebookId} {
        allow read: if isAuthenticated();
        allow write: if isResearcherOrAdmin();
      }
    }

    // ============ Context Documents ============

    match /context-documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update: if isResearcherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ API Keys (admin only) ============

    match /api-keys/{keyId} {
      allow read, write: if isAdmin();
    }

    // ============ File Attachments ============

    match /file-attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ============ Audit Logs (backend-only writes, immutable) ============

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Only service accounts (Cloud Functions / Admin SDK) can create logs.
      // Client SDK writes are blocked to prevent audit trail poisoning.
      allow create: if false;
      allow update, delete: if false;
    }

    // ============ Taxonomy ============

    match /taxonomy/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ Users ============

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Users can update their own profile but NOT privileged fields.
      // Only admins can change role, domain_ids, business_unit, monthly_token_budget.
      allow update: if isAdmin()
        || (isOwner(userId) && doesNotTouch(['role', 'domain_ids', 'business_unit', 'monthly_token_budget']));
      allow delete: if false;
    }

    // ============ Competitors ============

    match /competitors/{competitorId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update: if isResearcherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ Admin Collections ============

    match /prompt-templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ai-tool-profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /prompt-assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /context-rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ App Settings ============

    match /app-settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ API Usage ============

    match /api-usage/{entryId} {
      allow read: if isAdmin();
      // Only service accounts can create usage records
      allow create: if false;
      allow update, delete: if false;
    }
  }
}

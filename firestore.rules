rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helper Functions ============

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isResearcherOrAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'researcher'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============ Research ============

    match /research/{researchId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update: if isAuthenticated()
        && (resource.data.author_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      // Notebooks sub-collection
      match /notebooks/{notebookId} {
        allow read: if isAuthenticated();
        allow write: if isResearcherOrAdmin();
      }
    }

    // ============ Context Documents ============

    match /context-documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update: if isResearcherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ API Keys (admin only) ============

    match /api-keys/{keyId} {
      allow read, write: if isAdmin();
    }

    // ============ File Attachments ============

    match /file-attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ============ Audit Logs (write-only, immutable) ============

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============ Taxonomy ============

    match /taxonomy/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ Users ============

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ============ Competitors ============

    match /competitors/{competitorId} {
      allow read: if isAuthenticated();
      allow create: if isResearcherOrAdmin();
      allow update: if isResearcherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ Admin Collections ============

    match /prompt-templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ai-tool-profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /prompt-assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /context-rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ App Settings ============

    match /app-settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ API Usage ============

    match /api-usage/{entryId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
